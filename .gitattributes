# 统一文本换行, 避免 Windows / Linux 协作时整文件 diff
* text=auto eol=lf

# 源码与工程文件明确按文本处理
*.c    text eol=lf
*.h    text eol=lf
*.s    text eol=lf
*.ld   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# 二进制文件不做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.bin  binary
*.hex  binary
*.elf  binary
